<+>body{\r\n  margin: 0;\r\n  padding: 0;\r\n  font-family: 'Arial', sans-serif;\r\n  background-color: #1e293b !important; /* Cor de fundo escura */\r\n  color: #ffffff; /* Cor do texto clara */\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n.login-wrapper {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 100vh;\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.container {\r\n  width: 100%;\r\n  max-width: 450px;\r\n  background: rgba(255, 255, 255, 0.15);\r\n  backdrop-filter: blur(10px);\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 10px;\r\n  padding: 40px;\r\n  box-sizing: border-box;\r\n  border: 1px solid #ccc; /* Adiciona uma borda cinza */\r\n}\r\n\r\n.container h1 {\r\n  text-align: center;\r\n  font-size: 30px;\r\n  color: #ffff;\r\n}\r\n\r\n.container p {\r\n  margin: 10px;\r\n  text-align: left;\r\n  font-size: 14px;\r\n  color: #ffff;\r\n  border: 1px solid #ccc; /* Adiciona uma borda cinza */\r\n}\r\n\r\n.container .input-field {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 50px;\r\n  margin: 30px auto;\r\n}\r\n\r\n.input-field input {\r\n  width: 100%;\r\n  height: 100%;\r\n  outline: none;\r\n  border: 2px solid rgba(255, 255, 255, 0.2);\r\n  border-radius: 40px;\r\n  font-size: 16px;\r\n  color: #353333;\r\n  padding: 20px 45px 20px 25px;\r\n}\r\n\r\n.input-field input::placeholder {\r\n  color: #fff;\r\n}\r\n\r\n.input-field .icon {\r\n  position: absolute;\r\n  right: 25px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  font-size: 16px;\r\n  color: #334155;\r\n}\r\n\r\n.container .recall-forget {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  font-size: 14.5px;\r\n  margin: -15px 0 15px;\r\n}\r\n\r\n.recall-forget label input {\r\n  accent-color: #fff;\r\n  margin-right: 4px;\r\n}\r\n\r\n.recall-forget a {\r\n  color: #fff;\r\n  text-decoration: none;\r\n}\r\n\r\n.recall-forget a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.container button {\r\n  width: 100%;\r\n  height: 45px;\r\n  background: #fff;\r\n  border: none;\r\n  outline: none;\r\n  border-radius: 40px;\r\n  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n  color: #333;\r\n  font-weight: 700;\r\n  text-shadow: none;\r\n}\r\n\r\n.container .signup-link {\r\n  font-size: 14.5px;\r\n  text-align: center;\r\n  margin: 20px 0 15px;\r\n}\r\n\r\n.signup-link p {\r\n  align-items: center;\r\n  color: #fff;\r\n}\r\n\r\n.signup-link p a {\r\n  background-color: black;\r\n  padding-top: 10px;\r\n  color: #fff;\r\n  text-decoration: none;\r\n  font-weight: 600;\r\n}\r\n\r\n.signup-link p a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.logo-img {\r\n  display: block;\r\n  padding-top: 20px;\r\n  margin: 0 auto 20px auto; /* Centraliza a imagem perfeitamente em cima do container */\r\n  width: 250px;\r\n  height: auto;\r\n  filter: invert(1);\r\n  mix-blend-mode: screen;\r\n}\r\n\r\n.mensagem-erro{\r\n  color: rgb(219, 41, 41);\r\n  padding-top: 20px;\r\n}
